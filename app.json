{
  "expo": {
    "name": "TaxWisy",
    "slug": "TaxWisy",
    "scheme": "taxwisy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.jpg",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/logo.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a1a"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.jpg",
        "backgroundColor": "#0a0a1a"
      },
      "package": "com.taxwisy.app"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "TaxWisy needs access to your photos to update your profile picture.",
          "cameraPermission": "TaxWisy needs access to your camera to take a profile photo."
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "aae74157-12ba-4b45-a4eb-8a8b43c334d5"
      }
    }
  }
}
